# Default local development profile. See .env.postgres.example for PostgreSQL.
DATABASE_URL=sqlite:///./oxeyns.db
SECRET_KEY=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# M6 assistant (read-only). Use local for offline demo; openai/ollama need provider setup.
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=local
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=
