@startuml hinh-2-2-component-logic
!theme plain
title Hình 2.2 — Sơ đồ thành phần logic (3 tầng + 4 module)

skinparam componentStyle rectangle
skinparam shadowing false

actor "Người dùng\n(6 vai trò)" as User

package "Tầng trình diễn" as FE #E8F4FD {
  component [React 19 + TypeScript + Vite] as SPA
  component [api.ts / auth.ts] as ApiClient
  component [11 trang nghiệp vụ\n+ Login] as Pages
  SPA --> ApiClient
  SPA --> Pages
}

package "Tầng ứng dụng" as BE #FFF8E8 {
  component [FastAPI + uvicorn\n/api/v1] as API

  package "Routers" as Routers {
    component [auth] as RAuth
    component [stock\nmaterials] as RKho
    component [production] as RSX
    component [lab] as RLab
    component [reports\nquality] as RATTP
  }

  package "Services" as Services {
    component [ccp.py\nCCP1/CCP2] as CCP
    component [audit.py] as Audit
    component [pdf_export\ncsv_export] as Export
  }

  component [security.py\nJWT + RBAC] as Sec
  API --> Routers
  Routers --> Services
  Routers --> Sec
}

package "Tầng dữ liệu" as DB #F0FFF0 {
  database "SQLite\noxeyns.db" as SQLite
  component [SQLAlchemy ORM\nmodels.py — 14 bảng] as ORM
  ORM --> SQLite
}

User --> SPA : HTTPS
ApiClient --> API : REST JSON\nBearer JWT
Routers --> ORM

note right of CCP
  CCP1: C14 ∈ [13,02; 14,39]
  CCP2: Ttop ∈ [107; 110]°C
        % t-CA > 99%
end note

@enduml


