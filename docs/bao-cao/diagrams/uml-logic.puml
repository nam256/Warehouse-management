@startuml hinh-2-6-sequence-ccp-logic
!theme plain
title Hình 2.6 — Sơ đồ tuần tự logic đánh giá CCP (ccp.py)

actor "Người dùng" as U
participant "Router\n(stock/lab/production)" as R
participant "ccp.py" as CCP
database "SQLite" as DB

alt Nhập kho — CCP1
  U -> R : POST /stock/receipts {c14}
  R -> CCP : evaluate_ccp1(c14)
  alt c14 is None
    CCP --> R : pending
  else 13.02 <= c14 <= 14.39
    CCP --> R : pass
  else ngoài ngưỡng
    CCP --> R : fail
  end
  R -> DB : UPDATE stock_batches.ccp1_status
end

alt Lab — bổ sung CCP1/CCP2
  U -> R : POST /lab/tests
  R -> CCP : evaluate_ccp1 / evaluate_ccp2
  CCP --> R : status
  R -> DB : UPDATE lab_tests + batch/order
end

alt Hoàn thành mẻ — kiểm tra CCP2
  U -> R : POST /orders/{id}/complete
  R -> DB : SELECT operation_records
  R -> CCP : evaluate_ccp2(t_top, t_ca_percent)
  alt pass
    CCP --> R : pass
    R -> DB : INSERT lô TP, status=done
    R --> U : 200 OK
  else fail hoặc pending
    CCP --> R : fail/pending
    R --> U : 400 Chưa đạt CCP2
  end
end

@enduml


