@startuml hinh-2-4-activity-logic
!theme plain
title Hình 2.4 — Sơ đồ hoạt động logic nghiệp vụ (Kho → SX → Lab → ATTP)

start

:Thủ kho nhập kho NVL\nPOST /stock/receipts;
:Tạo stock_batches + movement IN;

if (Có giá trị C14?) then (có)
  :evaluate_ccp1(c14);
  if (13,02 ≤ C14 ≤ 14,39?) then (đạt)
    :ccp1_status = pass;
  else (không đạt)
    :ccp1_status = fail;
    :Ghi corrective_actions (tùy chọn);
    stop
  endif
else (chưa)
  :ccp1_status = pending;
endif

:QL NM duyệt mẻ\nPOST /orders/{id}/approve;

:Kỹ thuật bắt đầu mẻ\nPOST /orders/{id}/start;
if (ccp1_status == pass?) then (ok)
  :Xuất NVL → production_material_usages\n+ stock_movements OUT;
else (fail)
  :HTTP 400 — chặn xuất;
  stop
endif

:Kỹ thuật ghi operation record\nPOST /orders/{id}/operations;
:evaluate_ccp2(Ttop, % t-CA);

:Lab nhập kết quả\nPOST /lab/tests;
:Cập nhật C14 / % t-CA;

if (CCP2 pass?) then (đạt)
  :Hoàn thành mẻ\nPOST /orders/{id}/complete;
  :Tạo lô TP (stock_batches);
  :order.status = done;
else (fail/pending)
  :HTTP 400 — chặn hoàn thành;
  stop
endif

:ATTP truy xuất lô\nGET /reports/trace/{batch_no};
:Giám sát CCP / Audit / Export PDF;

:audit_logs ghi mọi bước;

stop

@enduml


